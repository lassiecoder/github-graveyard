# Public URL of the deployed site, used in share links and OG cards.
# On Vercel this falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=https://githubgraveyard.example

# GitHub token(s) with no scopes (public data only). Without one you get
# 60 requests/hour total. Comma-separate several to spread launch-day load:
# each token adds 5,000 requests/hour.
GITHUB_TOKENS=

# This project's GitHub repo (owner/name), linked from the "star this" card.
NEXT_PUBLIC_GITHUB_REPO=lassiecoder/github-graveyard

# Firebase web app config (Analytics). Mapped to NEXT_PUBLIC_FIREBASE_* in
# next.config.ts. Events are only sent from production builds.
API_KEYS=
AUTH_DOMAIN=
PROJECT_ID=
STORAGE_BUCKET=
MESSAGING_SENDER_ID=
APP_ID=
MEASUREMENT_ID=

# Dig counter (Firestore). The service account JSON from Firebase console →
# Project settings → Service accounts → Generate new private key, on one line.
# Server-only; never prefix with NEXT_PUBLIC_. Without it, digs aren't counted.
FIREBASE_SERVICE_ACCOUNT=
